+    // BlurpWorld start - the factory only depends on the biome registry, share it between levels and chunks
+    private record Cached(Registry<Biome> biomes, PalettedContainerFactory factory) {}
+    private static volatile @org.jspecify.annotations.Nullable Cached cached;
+
     public static PalettedContainerFactory create(final RegistryAccess registries) {
+        final Registry<Biome> biomes = registries.lookupOrThrow(Registries.BIOME);
+        final Cached current = cached;
