-    private static void addBiomeLayer(final EnvironmentAttributeSystem.Builder builder, final HolderLookup<Biome> biomes, final BiomeManager biomeManager) {
-        Stream<EnvironmentAttribute<?>> attributesProvidedByBiomes = biomes.listElements()
+    // BlurpWorld start - the attributes provided by biomes only depend on the registry, list them once
+    private record BiomeAttributes(HolderLookup<Biome> biomes, java.util.List<EnvironmentAttribute<?>> attributes) {}
+    private static volatile @org.jspecify.annotations.Nullable BiomeAttributes cachedBiomeAttributes;
+
+    private static java.util.List<EnvironmentAttribute<?>> attributesProvidedByBiomes(final HolderLookup<Biome> biomes) {
+        final BiomeAttributes current = cachedBiomeAttributes;
+        if (current != null && current.biomes() == biomes) {
+            return current.attributes();
+        }
+        final java.util.List<EnvironmentAttribute<?>> attributes = biomes.listElements()
             .flatMap(biome -> biome.value().getAttributes().keySet().stream())
-            .distinct();
-        attributesProvidedByBiomes.forEach(attribute -> addBiomeLayerForAttribute(builder, (EnvironmentAttribute<?>)attribute, biomeManager));
+            .<EnvironmentAttribute<?>>map(attribute -> attribute)
+            .distinct()
+            .toList();
+        cachedBiomeAttributes = new BiomeAttributes(biomes, attributes);
+        return attributes;
+    }
+    // BlurpWorld end - the attributes provided by biomes only depend on the registry, list them once
+
+    private static void addBiomeLayer(final EnvironmentAttributeSystem.Builder builder, final HolderLookup<Biome> biomes, final BiomeManager biomeManager) {
+        attributesProvidedByBiomes(biomes).forEach(attribute -> addBiomeLayerForAttribute(builder, attribute, biomeManager)); // BlurpWorld
     }
 
     private static <Value> void addBiomeLayerForAttribute(
